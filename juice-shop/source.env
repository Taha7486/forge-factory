# The upstream source of the Juice Shop image, pinned by COMMIT (a git tag can be moved, a commit
# hash cannot). build.sh fetches exactly this commit and stops if the checkout differs.
# To move to a new version: change COMMIT and TAG, run update-locks.sh, review the lock diff,
# and open a pull request.
UPSTREAM_REPO=https://github.com/juice-shop/juice-shop.git
UPSTREAM_COMMIT=f189f521266f42c6bd05884468292000cee852ed
UPSTREAM_TAG=v20.3.0
# Base images, by digest of the multi-platform index (checked 2026-10-17). Upstream leaves both floating.
NODE_IMAGE=docker.io/library/node:24@sha256:14078204b6bb268c107ceff6d3c43f45a888105e5c2b18b14c32b3409d93a1b0
RUNTIME_IMAGE=gcr.io/distroless/nodejs24-debian13@sha256:9ddd3f7de61d8c62337cdcbeaceb621de5e0c955ccdc70f4c3586db74a8c278f
